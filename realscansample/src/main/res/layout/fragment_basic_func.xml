<?xml version="1.0" encoding="utf-8"?>
    <!-- TODO: Update blank fragment layout -->

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.realscanseries.rssample.MainActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/basicfunctionlayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:weightSum="10"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.1"/>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:weightSum="10"
                android:orientation="vertical"
                android:layout_weight="9.8">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:orientation="vertical"
                    android:layout_weight="1.6">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:weightSum="10"
                        android:orientation="horizontal"
                        android:layout_weight="1">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1.5">

                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:weightSum="10"
                            android:layout_weight="7">
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="2">
                                <TextView
                                    android:id="@+id/deviceTextView"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    app:autoSizeTextType="uniform"
                                    app:autoSizeStepGranularity="1sp"
                                    app:autoSizeMinTextSize="2sp"
                                    app:autoSizeMaxTextSize="10sp"
                                    android:gravity="center|bottom"
                                    android:text="@string/tv_deviceinfo" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:weightSum="10"
                                android:layout_weight="6">
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"/>
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="8">
                                    <TextView
                                        android:id="@+id/tvDevice"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:layout_toEndOf="@id/deviceTextView"
                                        app:autoSizeTextType="uniform"
                                        app:autoSizeStepGranularity="1sp"
                                        app:autoSizeMinTextSize="2sp"
                                        app:autoSizeMaxTextSize="10sp"
                                        android:background="@drawable/underline"
                                        android:gravity="center|bottom" />
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"/>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="2">
                                <Button
                                    android:id="@+id/btSelectDevice"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_gravity="center"
                                    android:layout_toEndOf="@+id/tvDevice"
                                    android:background="@drawable/button_round"
                                    android:stateListAnimator="@null"
                                    android:text="Select Device"
                                    android:visibility="invisible" />
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1.5">

                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:weightSum="10"
                        android:orientation="horizontal"
                        android:layout_weight="1">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1.5">

                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:weightSum="10"
                            android:layout_weight="7">
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="2">
                                <TextView
                                    android:id="@+id/sdkInfoTextView"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    app:autoSizeTextType="uniform"
                                    app:autoSizeStepGranularity="1sp"
                                    app:autoSizeMinTextSize="2sp"
                                    app:autoSizeMaxTextSize="10sp"
                                    android:gravity="center|bottom"
                                    android:text="@string/tv_sdkinfo" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:weightSum="10"
                                android:layout_weight="6">
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"/>
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="8">
                                    <TextView
                                        android:id="@+id/tvsdkinfo"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:background="@drawable/underline"
                                        android:layout_toEndOf="@id/modeTextView"
                                        app:autoSizeTextType="uniform"
                                        app:autoSizeStepGranularity="1sp"
                                        app:autoSizeMinTextSize="2sp"
                                        app:autoSizeMaxTextSize="10sp"
                                        android:gravity="center|bottom" />
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"/>
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="2">

                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1.5">

                        </LinearLayout>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:weightSum="10"
                        android:orientation="horizontal"
                        android:layout_weight="1">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1.5">

                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:weightSum="10"
                            android:layout_weight="7">
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="2">
                                <TextView
                                    android:id="@+id/modeTextView"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    app:autoSizeTextType="uniform"
                                    app:autoSizeStepGranularity="1sp"
                                    app:autoSizeMinTextSize="2sp"
                                    app:autoSizeMaxTextSize="10sp"
                                    android:gravity="center|bottom"
                                    android:text="@string/tv_modename" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:weightSum="10"
                                android:layout_weight="6">
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"/>
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="8">

                                    <TextView
                                        android:id="@+id/tvMode"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:background="@drawable/underline"
                                        android:layout_toEndOf="@id/modeTextView"
                                        app:autoSizeTextType="uniform"
                                        app:autoSizeStepGranularity="1sp"
                                        app:autoSizeMinTextSize="2sp"
                                        app:autoSizeMaxTextSize="10sp"
                                        android:gravity="center|bottom" />
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="match_parent"
                                    android:layout_weight="1"/>

                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="2">
                                <Button
                                    android:id="@+id/btSelectMode"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_gravity="center"
                                    android:layout_toEndOf="@+id/tvMode"
                                    android:background="@drawable/buttonselector"
                                    app:autoSizeTextType="uniform"
                                    app:autoSizeStepGranularity="1sp"
                                    app:autoSizeMinTextSize="2sp"
                                    app:autoSizeMaxTextSize="10sp"
                                    android:stateListAnimator="@null"
                                    android:text="@string/bt_capturemode" />
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1.5">

                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:orientation="vertical"
                    android:layout_weight="0.35">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/tv_fullcaptureimage"
                        app:autoSizeTextType="uniform"
                        app:autoSizeStepGranularity="1sp"
                        app:autoSizeMinTextSize="2sp"
                        app:autoSizeMaxTextSize="10sp"
                        android:gravity="center"/>

                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:id="@+id/captureInfo"
                    android:orientation="horizontal"
                    android:layout_weight="4.7"
                    android:background="@drawable/edit_round">

                    <ImageView
                        android:id="@+id/_ivCapture"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="6dp"
                        android:layout_marginLeft="6dp"
                        android:layout_marginRight="6dp"
                        android:layout_marginBottom="6dp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:id="@+id/segmenttext"
                    android:layout_weight="0.35">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:id="@+id/_tvSeg1"
                        android:text="@string/textview_segment1"
                        app:autoSizeTextType="uniform"
                        app:autoSizeStepGranularity="1sp"
                        app:autoSizeMinTextSize="2sp"
                        app:autoSizeMaxTextSize="10sp"
                        android:gravity="center"
                        android:layout_weight="1"/>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/textview_segment2"
                        app:autoSizeTextType="uniform"
                        app:autoSizeStepGranularity="1sp"
                        app:autoSizeMinTextSize="2sp"
                        app:autoSizeMaxTextSize="10sp"
                        android:id="@+id/_tvSeg2"
                        android:gravity="center"
                        android:layout_weight="1"/>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/textview_segment3"
                        app:autoSizeTextType="uniform"
                        app:autoSizeStepGranularity="1sp"
                        app:autoSizeMinTextSize="2sp"
                        app:autoSizeMaxTextSize="10sp"
                        android:id="@+id/_tvSeg3"
                        android:gravity="center"
                        android:layout_weight="1"/>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/textview_segment4"
                        app:autoSizeTextType="uniform"
                        app:autoSizeStepGranularity="1sp"
                        app:autoSizeMinTextSize="2sp"
                        app:autoSizeMaxTextSize="10sp"
                        android:id="@+id/_tvSeg4"
                        android:gravity="center"
                        android:layout_weight="1"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:id="@+id/segmentInfo"
                    android:layout_below="@id/captureInfo"
                    android:orientation="horizontal"
                    android:layout_weight="2">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:weightSum="10"
                        android:orientation="horizontal"
                        android:layout_weight="1">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.1"/>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/edit_round"
                            android:layout_weight="9.8">
                            <ImageView
                                android:id="@+id/_ivSeg1"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginTop="6dp"
                                android:layout_marginLeft="6dp"
                                android:layout_marginRight="6dp"
                                android:layout_marginBottom="6dp"
                                android:scaleType="fitCenter"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.1"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:weightSum="10"
                        android:orientation="horizontal"
                        android:layout_weight="1">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.1"/>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/edit_round"
                            android:layout_weight="9.8">
                            <ImageView
                                android:id="@+id/_ivSeg2"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginTop="6dp"
                                android:layout_marginLeft="6dp"
                                android:layout_marginRight="6dp"
                                android:layout_marginBottom="6dp"
                                android:scaleType="fitCenter"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.1"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:weightSum="10"
                        android:orientation="horizontal"
                        android:layout_weight="1">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.1"/>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/edit_round"
                            android:layout_weight="9.8">
                            <ImageView
                                android:id="@+id/_ivSeg3"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginTop="6dp"
                                android:layout_marginLeft="6dp"
                                android:layout_marginRight="6dp"
                                android:layout_marginBottom="6dp"
                                android:scaleType="fitCenter"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.1"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:weightSum="10"
                        android:orientation="horizontal"
                        android:layout_weight="1">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.1"/>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/edit_round"
                            android:layout_weight="9.8">
                            <ImageView
                                android:id="@+id/_ivSeg4"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_marginTop="6dp"
                                android:layout_marginLeft="6dp"
                                android:layout_marginRight="6dp"
                                android:layout_marginBottom="6dp"
                                android:scaleType="fitCenter"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.1"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:id="@+id/segmentInfoResult"
                    android:layout_weight="0.3">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:id="@+id/_seg1_Info_result"
                        android:text="@string/textview_empty"
                        app:autoSizeTextType="uniform"
                        app:autoSizeStepGranularity="1sp"
                        app:autoSizeMinTextSize="3sp"
                        app:autoSizeMaxTextSize="11sp"
                        android:gravity="center"
                        android:layout_weight="1"/>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/textview_empty"
                        app:autoSizeTextType="uniform"
                        app:autoSizeStepGranularity="1sp"
                        app:autoSizeMinTextSize="3sp"
                        app:autoSizeMaxTextSize="11sp"
                        android:id="@+id/_seg2_Info_result"
                        android:gravity="center"
                        android:layout_weight="1"/>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/textview_empty"
                        app:autoSizeTextType="uniform"
                        app:autoSizeStepGranularity="1sp"
                        app:autoSizeMinTextSize="3sp"
                        app:autoSizeMaxTextSize="11sp"
                        android:id="@+id/_seg3_Info_result"
                        android:gravity="center"
                        android:layout_weight="1"/>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/textview_empty"
                        app:autoSizeTextType="uniform"
                        app:autoSizeStepGranularity="1sp"
                        app:autoSizeMinTextSize="3sp"
                        app:autoSizeMaxTextSize="11sp"
                        android:id="@+id/_seg4_Info_result"
                        android:gravity="center"
                        android:layout_weight="1"/>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="0.1"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:id="@+id/functionInfo"
                    android:layout_below="@id/segmentInfo"
                    android:orientation="horizontal"
                    android:layout_weight="0.5">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:weightSum="10"
                        android:layout_weight="1">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.1"/>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="9.8">
                            <Button
                                android:id="@+id/btStartPreview"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/buttonselector"
                                app:autoSizeTextType="uniform"
                                app:autoSizeStepGranularity="1sp"
                                app:autoSizeMinTextSize="2sp"
                                app:autoSizeMaxTextSize="10sp"
                                android:stateListAnimator="@null"
                                android:text="@string/bt_previewcapture" />

                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.1"/>

                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:weightSum="10"
                        android:layout_weight="1">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.1"/>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="9.8">
                            <Button
                                android:id="@+id/btManualCapture"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:enabled="false"
                                android:background="@drawable/buttonselector"
                                app:autoSizeTextType="uniform"
                                app:autoSizeStepGranularity="1sp"
                                app:autoSizeMinTextSize="2sp"
                                app:autoSizeMaxTextSize="10sp"
                                android:stateListAnimator="@null"
                                android:text="@string/bt_manualcapture" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.1"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:weightSum="10"
                        android:layout_weight="1">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.1"/>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="9.8">
                            <Button
                                android:id="@+id/btAutoCapture"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/buttonselector"
                                app:autoSizeTextType="uniform"
                                app:autoSizeStepGranularity="1sp"
                                app:autoSizeMinTextSize="2sp"
                                app:autoSizeMaxTextSize="10sp"
                                android:stateListAnimator="@null"
                                android:text="@string/bt_autocapture" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.1"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:weightSum="10"
                        android:layout_weight="1">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.1"/>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="9.8">
                            <Button
                                android:id="@+id/btAbortCapture"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/buttonselector"
                                app:autoSizeTextType="uniform"
                                app:autoSizeStepGranularity="1sp"
                                app:autoSizeMinTextSize="2sp"
                                app:autoSizeMaxTextSize="10sp"
                                android:stateListAnimator="@null"
                                android:text="@string/bt_abortcapture" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.1"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:weightSum="10"
                        android:layout_weight="1">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.1"/>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="9.8">
                            <Button
                                android:id="@+id/btSaveImage"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/buttonselector"
                                app:autoSizeTextType="uniform"
                                app:autoSizeStepGranularity="1sp"
                                app:autoSizeMinTextSize="2sp"
                                app:autoSizeMaxTextSize="10sp"
                                android:stateListAnimator="@null"
                                android:text="@string/bt_saveimage" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.1"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.1"/>

        </LinearLayout>
    </RelativeLayout>
</FrameLayout>